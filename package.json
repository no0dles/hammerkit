{
  "name": "hammerkit",
  "description": "Containerized build tool with incremental caching that runs the same build file locally, in Docker and on Kubernetes.",
  "version": "1.8.0",
  "keywords": [
    "build",
    "build-tool",
    "ci",
    "docker",
    "kubernetes",
    "cache",
    "monorepo",
    "task-runner"
  ],
  "homepage": "https://hammerkit.dev",
  "bin": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/testing",
    "!dist/**/*.map",
    "build.schema.json"
  ],
  "bugs": {
    "url": "https://github.com/no0dles/hammerkit/issues"
  },
  "author": {
    "name": "no0dles",
    "url": "https://github.com/no0dles"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "url": "https://github.com/no0dles/hammerkit",
    "type": "git"
  },
  "scripts": {
    "prepack": "tsc -b tsconfig.json",
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --mode integration",
    "test:mutation": "stryker run",
    "format": "prettier -w src/** && eslint . --fix --ext .ts",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.470.0",
    "@kubernetes/client-node": "^2.0.0",
    "chokidar": "^3.6.0",
    "colors": "^1.4.0",
    "commander": "^11.1.0",
    "dockerode": "^4.0.12",
    "find-process": "^1.4.7",
    "minimatch": "^6.2.3",
    "tar": "^7.5.22",
    "yaml": "^2.9.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/dockerode": "^3.3.23",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitest/coverage-istanbul": "^2.1.8",
    "@yao-pkg/pkg": "^6.20.0",
    "eslint": "^8.56.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8",
    "zod-to-json-schema": "^3.20.2"
  }
}
