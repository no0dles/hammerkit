{
  "branches": ["master", { "name": "release/approved-q576fo", "prerelease": "next", "channel": "next" }],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    ["@semantic-release/npm", { "npmPublish": false }],
    ["@semantic-release/git", { "assets": ["package.json", "package-lock.json", "CHANGELOG.md"] }],
    [
      "@semantic-release/exec",
      {
        "successCmd": "gh workflow run push.yaml --ref v${nextRelease.version} && gh workflow run website.yaml --ref master"
      }
    ]
  ]
}
