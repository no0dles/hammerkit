{
  "compilerOptions": {
    "rootDir": "src",
    "lib": ["ES2020"],
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "downlevelIteration": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "temp",
    "examples",
    "vitest.config.ts"
  ]
}
