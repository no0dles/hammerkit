{
  "name": "hammerkit-dashboard",
  "private": true,
  "type": "module",
  "description": "The dashboard of a hammerkit server: a React app the server serves at hammerkit.<domain>, built into dist/dashboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
